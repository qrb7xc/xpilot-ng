      "name": "XPilotNG Data",
      "id": "E3E0AECF080527B30080821B",
      "kind": "aggregate",
      "build-phases": [
        {
          "kind": "script",
          "name": "Run Script",
          "log-environment-variables": true,
          "shell": "/bin/sh",
          "script": [
            "packages=${BUILD_ROOT}/packages",
            "data_package=${packages}/data",
            "contents=${data_package}/contents",
            "rm -rf ${contents}",
            "",
          ],
        }, {
          "kind": "copy",
          "id": "E32F97E108FB0B2200AE0B2A",
          "name": "Copy Files",
          "bundle-base-path": "build-products-directory",
          "relative-path": "packages/data",
        }, {
          "kind": "copy",
          "id": "E32F97E308FB0BA000AE0B2A",
          "name": "Copy Files",
          "bundle-base-path": "build-products-directory",
          "relative-path": "packages/data/contents",
        }, {
          "kind": "script",
          "name": "Run Script",
          "log-environment-variables": true,
          "shell": "/bin/sh",
          "script": [
            "packages=${BUILD_ROOT}/packages",
            "data_package=${packages}/data",
            "contents=${data_package}/contents",
            "rm -rf $(find ${contents} -name 'Makefile*')",
            "rm -rf $(find ${contents} -name '.cvsignore')",
            "rm -rf $(find ${contents} -name 'CVS')",
            "mv -f ${contents}/lib/* ${contents}/",
            "rmdir ${contents}/lib",
            "",
          ],
        },
      ],
      "build-settings": {
        "CLANG_ENABLE_OBJC_WEAK": "YES",
        "COPY_PHASE_STRIP[config=Debug]": "NO",
        "COPY_PHASE_STRIP[config=Release]": "YES",
        "DEAD_CODE_STRIPPING": "YES",
